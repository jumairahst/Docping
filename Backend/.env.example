# Environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/docping

# Firebase Admin SDK
# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Path to your downloaded Firebase service account JSON (see SETUP.md).
# Keep this file OUT of git.
# Only required if your project uses Firebase Realtime Database.
FIREBASE_DATABASE_URL=

# CORS origin for the frontend (webpack dev server on 3000)
CORS_ORIGIN=http://localhost:3000
